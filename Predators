<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Sea Urchin Removal & Kelp Recovery</title>
<style>
  :root {
    --bg: #081826;
    --panel: #0f2537;
    --border: #1e425e;
    --text: #e6f4f1;
    --muted: #8ab4c9;
    --accent: #2dd4bf;
    --purple: #a855f7;
  }
  * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    display: flex; flex-direction: column; height: 100vh; overflow: hidden;
  }
  header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 20px; background: var(--panel); border-bottom: 1px solid var(--border);
  }
  .title-group h1 { margin: 0; font-size: 16px; font-weight: 700; color: var(--accent); }
  .title-group p { margin: 2px 0 0; font-size: 12px; color: var(--muted); }
  .metrics { display: flex; gap: 20px; }
  .metric { text-align: right; }
  .metric span { display: block; font-size: 11px; color: var(--muted); text-transform: uppercase; }
  .metric strong { font-size: 18px; color: var(--text); }

  #viewport { position: relative; flex: 1; width: 100%; overflow: hidden; cursor: pointer; }
  canvas { display: block; width: 100%; height: 100%; }

  .hint-badge {
    position: absolute; top: 14px; left: 16px;
    background: rgba(15, 37, 55, 0.9); border: 1px solid var(--border);
    border-radius: 8px; padding: 8px 12px; font-size: 12px; color: var(--muted);
    pointer-events: none;
  }

  footer {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 20px; background: var(--panel); border-top: 1px solid var(--border);
  }
  .actions { display: flex; gap: 10px; }
  .btn {
    padding: 8px 14px; font-size: 12px; font-weight: 600; border-radius: 6px;
    cursor: pointer; border: 1px solid var(--accent); background: #14344d; color: var(--text);
    transition: 0.15s;
  }
  .btn:hover { background: var(--accent); color: #042f2e; }
  .reset-btn {
    padding: 8px 14px; background: transparent; color: var(--muted);
    border: 1px solid var(--border); border-radius: 6px; cursor: pointer; font-size: 12px;
  }
  .reset-btn:hover { color: var(--text); border-color: var(--text); }
</style>
</head>
<body>

<header>
  <div class="title-group">
    <h1>2. Sea Urchin Grazing Control</h1>
    <p>Click urchins on the reef to cull them or restore natural predators</p>
  </div>
  <div class="metrics">
    <div class="metric">
      <span>Urchin Density</span>
      <strong id="urchinCount" style="color: #c084fc;">28</strong>
    </div>
    <div class="metric">
      <span>Kelp Canopy</span>
      <strong id="canopyVal" style="color: #2dd4bf;">10%</strong>
    </div>
  </div>
</header>

<div id="viewport">
  <canvas id="ocean"></canvas>
  <div class="hint-badge">Tip: Click directly on purple sea urchins to remove them from holdfasts</div>
</div>

<footer>
  <div class="actions">
    <button class="btn" onclick="cullBatch(6)">Diver Cull (-6 Urchins)</button>
    <button class="btn" onclick="reintroduceOtters()">Introduce Sea Otters (-12 Urchins)</button>
  </div>
  <button class="reset-btn" onclick="resetBarren()">Reset Urchin Barren</button>
</footer>

<script>
  const canvas = document.getElementById('ocean');
  const ctx = canvas.getContext('2d');
  let width, height;
  let kelps = [];
  let urchins = [];
  let time = 0;

  function resize() {
    width = canvas.width = canvas.parentElement.clientWidth;
    height = canvas.height = canvas.parentElement.clientHeight;
    if (kelps.length === 0) resetBarren();
  }
  window.addEventListener('resize', resize);

  function resetBarren() {
    kelps = [];
    urchins = [];
    const kelpCount = Math.floor(width / 34);
    for (let i = 0; i < kelpCount; i++) {
      kelps.push({
        x: 24 + i * 34,
        maxH: height * (0.58 + Math.random() * 0.24),
        growth: 0.08,
        phase: Math.random() * Math.PI * 2
      });
    }
    const uCount = 28;
    for (let i = 0; i < uCount; i++) {
      urchins.push({
        x: 20 + Math.random() * (width - 40),
        y: height - 34 - Math.random() * 10,
        vx: (Math.random() - 0.5) * 0.4,
        radius: 13
      });
    }
    updateMetrics();
  }

  function cullBatch(n) {
    urchins.splice(0, Math.min(n, urchins.length));
    updateMetrics();
  }

  function reintroduceOtters() {
    urchins.splice(0, Math.min(12, urchins.length));
    updateMetrics();
  }

  canvas.addEventListener('click', (e) => {
    const rect = canvas.getBoundingClientRect();
    const mx = e.clientX - rect.left;
    const my = e.clientY - rect.top;
    for (let i = urchins.length - 1; i >= 0; i--) {
      const u = urchins[i];
      if (Math.hypot(mx - u.x, my - u.y) <= u.radius + 10) {
        urchins.splice(i, 1);
        updateMetrics();
        break;
      }
    }
  });

  function updateMetrics() {
    document.getElementById('urchinCount').textContent = urchins.length;
    const targetCanopy = Math.max(0.08, 1 - urchins.length / 30);
    document.getElementById('canopyVal').textContent = Math.round(targetCanopy * 100) + '%';
  }

  function drawUrchin(u) {
    ctx.save();
    ctx.translate(u.x, u.y);
    ctx.strokeStyle = '#9333ea';
    ctx.lineWidth = 2;
    const spikes = 14;
    for (let i = 0; i < spikes; i++) {
      const angle = (Math.PI * 2 * i) / spikes + time * 0.2;
      ctx.beginPath();
      ctx.moveTo(0, 0);
      ctx.lineTo(Math.cos(angle) * (u.radius + 5), Math.sin(angle) * (u.radius + 5));
      ctx.stroke();
    }
    ctx.fillStyle = '#581c87';
    ctx.beginPath();
    ctx.arc(0, 0, u.radius * 0.65, 0, Math.PI * 2);
    ctx.fill();
    ctx.restore();
  }

  function draw() {
    time += 0.03;
    const grad = ctx.createLinearGradient(0, 0, 0, height);
    grad.addColorStop(0, '#0c4a6e');
    grad.addColorStop(1, '#040d14');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, width, height);

    // Rocky reef
    ctx.fillStyle = '#13222e';
    ctx.fillRect(0, height - 28, width, 28);

    const targetGrowth = Math.max(0.08, 1 - urchins.length / 30);

    kelps.forEach((k) => {
      k.growth += (targetGrowth - k.growth) * 0.03;
      const currentH = k.maxH * k.growth;
      const baseY = height - 26;

      ctx.strokeStyle = '#22c55e';
      ctx.lineWidth = 4;
      ctx.beginPath();
      ctx.moveTo(k.x, baseY);

      const segments = 12;
      for (let s = 1; s <= segments; s++) {
        const frac = s / segments;
        const sway = Math.sin(time + k.phase + frac * 3) * (14 * frac);
        const px = k.x + sway;
        const py = baseY - currentH * frac;
        ctx.lineTo(px, py);

        if (s > 2 && s % 2 === 0 && k.growth > 0.18) {
          ctx.fillStyle = '#16a34a';
          ctx.beginPath();
          const dir = (s % 4 === 0) ? 1 : -1;
          ctx.ellipse(px + dir * 12 * k.growth, py, 14 * k.growth, 4 * k.growth, dir * 0.3, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      ctx.stroke();
    });

    urchins.forEach((u) => {
      u.x += u.vx;
      if (u.x < 20 || u.x > width - 20) u.vx *= -1;
      drawUrchin(u);
    });

    requestAnimationFrame(draw);
  }

  resize();
  draw();
</script>
</body>
</html>
