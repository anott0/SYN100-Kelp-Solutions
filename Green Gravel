<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Green Gravel Kelp Restoration</title>
<style>
  :root {
    --bg: #081826;
    --panel: #0f2537;
    --border: #1e425e;
    --text: #e6f4f1;
    --muted: #8ab4c9;
    --accent: #2dd4bf;
  }
  * { box-sizing: border-box; font-family: system-ui, -apple-system, sans-serif; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    display: flex; flex-direction: column; height: 100vh; overflow: hidden;
  }
  header {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 20px; background: var(--panel); border-bottom: 1px solid var(--border);
  }
  .title-group h1 { margin: 0; font-size: 16px; font-weight: 700; color: var(--accent); }
  .title-group p { margin: 2px 0 0; font-size: 12px; color: var(--muted); }
  .metrics { display: flex; gap: 20px; }
  .metric { text-align: right; }
  .metric span { display: block; font-size: 11px; color: var(--muted); text-transform: uppercase; }
  .metric strong { font-size: 18px; color: var(--text); }

  #viewport { position: relative; flex: 1; width: 100%; overflow: hidden; }
  canvas { display: block; width: 100%; height: 100%; }

  footer {
    display: flex; align-items: center; justify-content: space-between; gap: 12px;
    padding: 12px 20px; background: var(--panel); border-top: 1px solid var(--border);
  }
  .actions { display: flex; gap: 10px; }
  .btn {
    padding: 8px 14px; font-size: 12px; font-weight: 600; border-radius: 6px;
    cursor: pointer; border: 1px solid var(--accent); background: #14344d; color: var(--text);
    transition: 0.15s;
  }
  .btn:hover { background: var(--accent); color: #042f2e; }
  .reset-btn {
    padding: 8px 14px; background: transparent; color: var(--muted);
    border: 1px solid var(--border); border-radius: 6px; cursor: pointer; font-size: 12px;
  }
  .reset-btn:hover { color: var(--text); border-color: var(--text); }
</style>
</head>
<body>

<header>
  <div class="title-group">
    <h1>3. Green Gravel Seeding (Diver Deployment)</h1>
    <p>Deploy divers to scatter sporophyte-seeded rocks across barren seabed</p>
  </div>
  <div class="metrics">
    <div class="metric">
      <span>Seeded Rocks</span>
      <strong id="rockCount" style="color: #2dd4bf;">0</strong>
    </div>
    <div class="metric">
      <span>Forest Coverage</span>
      <strong id="covVal" style="color: #2dd4bf;">0%</strong>
    </div>
  </div>
</header>

<div id="viewport">
  <canvas id="ocean"></canvas>
</div>

<footer>
  <div class="actions">
    <button class="btn" onclick="deployDiver()">Hire Restoration Diver (+10 Gravel)</button>
    <button class="btn" onclick="boatDrop()">Surface Boat Scatter (+20 Gravel)</button>
  </div>
  <button class="reset-btn" onclick="resetSeabed()">Reset Barren Seabed</button>
</footer>

<script>
  const canvas = document.getElementById('ocean');
  const ctx = canvas.getContext('2d');
  let width, height;
  let divers = [];
  let rocks = [];
  let time = 0;

  function resize() {
    width = canvas.width = canvas.parentElement.clientWidth;
    height = canvas.height = canvas.parentElement.clientHeight;
  }
  window.addEventListener('resize', resize);

  function resetSeabed() {
    divers = [];
    rocks = [];
    updateMetrics();
  }

  function deployDiver() {
    divers.push({
      x: -40,
      y: height * (0.35 + Math.random() * 0.25),
      speed: 2.6,
      dropsLeft: 10,
      dropTimer: 0
    });
  }

  function boatDrop() {
    for (let i = 0; i < 20; i++) {
      rocks.push({
        x: 30 + Math.random() * (width - 60),
        y: 20 + Math.random() * 40,
        targetY: height - 26 - Math.random() * 6,
        vy: 1.5 + Math.random(),
        settled: false,
        growth: 0,
        maxH: height * (0.48 + Math.random() * 0.28),
        phase: Math.random() * Math.PI * 2
      });
    }
    updateMetrics();
  }

  function updateMetrics() {
    document.getElementById('rockCount').textContent = rocks.length;
    const maxCapacity = Math.max(1, Math.floor(width / 22));
    const pct = Math.min(100, Math.round((rocks.length / maxCapacity) * 100));
    document.getElementById('covVal').textContent = pct + '%';
  }

  function drawDiver(d) {
    ctx.save();
    ctx.translate(d.x, d.y);
    // Diver body
    ctx.fillStyle = '#38bdf8';
    ctx.beginPath();
    ctx.ellipse(0, 0, 22, 7, 0, 0, Math.PI * 2);
    ctx.fill();
    // Scuba tank
    ctx.fillStyle = '#facc15';
    ctx.fillRect(-10, -11, 16, 5);
    // Mask
    ctx.fillStyle = '#e0f2fe';
    ctx.beginPath();
    ctx.arc(18, -1, 5, 0, Math.PI * 2);
    ctx.fill();
    // Fins
    const kick = Math.sin(time * 6) * 5;
    ctx.strokeStyle = '#0284c7';
    ctx.lineWidth = 4;
    ctx.beginPath();
    ctx.moveTo(-20, 0);
    ctx.lineTo(-32, kick);
    ctx.stroke();
    ctx.restore();
  }

  function draw() {
    time += 0.03;
    const grad = ctx.createLinearGradient(0, 0, 0, height);
    grad.addColorStop(0, '#0c4a6e');
    grad.addColorStop(1, '#040d14');
    ctx.fillStyle = grad;
    ctx.fillRect(0, 0, width, height);

    // Sandy/rocky seabed
    ctx.fillStyle = '#13222e';
    ctx.fillRect(0, height - 28, width, 28);

    // Update & draw divers
    for (let i = divers.length - 1; i >= 0; i--) {
      const d = divers[i];
      d.x += d.speed;
      d.dropTimer++;
      if (d.dropsLeft > 0 && d.x > 40 && d.x < width - 40 && d.dropTimer % 22 === 0) {
        d.dropsLeft--;
        rocks.push({
          x: d.x + (Math.random() * 16 - 8),
          y: d.y + 8,
          targetY: height - 26 - Math.random() * 6,
          vy: 1.6,
          settled: false,
          growth: 0,
          maxH: height * (0.48 + Math.random() * 0.28),
          phase: Math.random() * Math.PI * 2
        });
        updateMetrics();
      }
      drawDiver(d);
      if (d.x > width + 50) divers.splice(i, 1);
    }

    // Update & draw green gravel + growing kelp
    rocks.forEach((r) => {
      if (!r.settled) {
        r.y += r.vy;
        if (r.y >= r.targetY) {
          r.y = r.targetY;
          r.settled = true;
        }
      } else if (r.growth < 1) {
        r.growth = Math.min(1, r.growth + 0.004);
      }

      // Gravel pebble
      ctx.fillStyle = '#4ade80';
      ctx.beginPath();
      ctx.ellipse(r.x, r.y, 6, 4, 0, 0, Math.PI * 2);
      ctx.fill();

      // Sprouting kelp
      if (r.settled && r.growth > 0.02) {
        const currentH = r.maxH * r.growth;
        ctx.strokeStyle = '#22c55e';
        ctx.lineWidth = 3.5;
        ctx.beginPath();
        ctx.moveTo(r.x, r.y);

        const segments = 10;
        for (let s = 1; s <= segments; s++) {
          const frac = s / segments;
          const sway = Math.sin(time + r.phase + frac * 3) * (12 * frac);
          const px = r.x + sway;
          const py = r.y - currentH * frac;
          ctx.lineTo(px, py);

          if (s > 2 && s % 2 === 0 && r.growth > 0.2) {
            ctx.fillStyle = '#16a34a';
            ctx.beginPath();
            const dir = (s % 4 === 0) ? 1 : -1;
            ctx.ellipse(px + dir * 10 * r.growth, py, 12 * r.growth, 3.5 * r.growth, dir * 0.3, 0, Math.PI * 2);
            ctx.fill();
          }
        }
        ctx.stroke();
      }
    });

    requestAnimationFrame(draw);
  }

  resize();
  draw();
</script>
</body>
</html>
